# Copy to .env for local runs of `npm run fetch`. Every key is optional; the
# page degrades honestly without each one. In production these are repository
# secrets read by .github/workflows/pages.yml — the same names.

# GitHub — optional. Raises the API rate limit; `gh auth token` is used if unset.
GH_TOKEN=

# Ghost — Settings → Integrations → Add custom integration.
GHOST_URL=https://www.imswarnil.com
GHOST_CONTENT_KEY=
GHOST_ADMIN_KEY=

# YouTube — a Data API v3 key, and the channel as a UC… id or an @handle.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL=
