# Copy to .env.local for `npm run dev`. Every key is optional and the page
# degrades honestly without each one.
#
# In production these are Worker secrets, not build variables — upload them
# with `wrangler secret put NAME`. They are read at request time, so adding one
# changes the live page without a redeploy.

# GitHub — without a token the API allows 60 requests/hour per IP, which a
# Worker will exhaust quickly. With one, 5000.
GH_TOKEN=

# Ghost — Settings → Integrations → Add custom integration.
GHOST_URL=https://www.imswarnil.com
GHOST_CONTENT_KEY=
GHOST_ADMIN_KEY=

# YouTube — a Data API v3 key, and the channel as a UC… id or an @handle.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL=

# X — a v2 API bearer token (Basic tier or above for /users/:id/tweets).
X_BEARER_TOKEN=

# Spotify — an app's client id/secret, plus a refresh token issued with the
# scopes user-read-currently-playing user-read-recently-played user-top-read.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Guestbook — a Neon connection string. Run `npm run db:init` once after
# setting it. Without it the guestbook renders with its form disabled.
DATABASE_URL=
# Optional: salts the hashed IP used for rate-limiting. Any random string.
GUESTBOOK_SALT=
